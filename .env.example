# EVE Online SSO
EVE_CLIENT_ID=your_production_client_id
EVE_CLIENT_SECRET=your_production_client_secret
EVE_CALLBACK_URL=https://yourdomain.com/auth/callback

# App
SECRET_KEY=change_this_to_a_long_random_string
# Must name an ASYNC driver — the app builds an asyncio engine, so a plain
# `sqlite:///` URL fails at startup with "The asyncio extension requires an
# async driver to be used". Docker overrides this to /data/vigilant.db.
DATABASE_URL=sqlite+aiosqlite:///./vigilant.db
DEBUG=false

# EVE character id of the owner/admin. On a fresh deploy with no admin yet,
# ONLY the account that owns this character is auto-promoted to admin at
# startup. Leave unset and no one is auto-promoted (fail closed) — the app
# will log a reminder. Set this to your own character id before first launch.
# ADMIN_CHARACTER_ID=

# Contact address advertised in the outbound HTTP User-Agent, e.g.
# "Vigilant/1.0 (you@example.com)". The third-party APIs this app calls (ESI,
# zKillboard, eve-offline.net/.com, EVE-Scout) all require a real, reachable
# contact so their operators can get hold of whoever is generating the traffic.
# Leave unset and requests go out carrying the project's issue-tracker URL,
# which reaches the maintainers but NOT you — set this to your OWN email so you
# get contacted about your own instance's traffic.
# CONTACT_EMAIL=

# For local dev override these in .env
# EVE_CLIENT_ID=your_dev_client_id
# EVE_CLIENT_SECRET=your_dev_client_secret
# EVE_CALLBACK_URL=http://localhost:8000/auth/callback

# Discord webhooks (both optional, both no-op when unset — and DELIBERATELY
# separate from each other, don't alias them):
# DISCORD_WEBHOOK is the shared ops/backfill-progress ping (see everef_ingest.py).
# DISCORD_WEBHOOK_URL is the user-facing alert relay (structure attacks, fuel
# alerts, etc — see app/notify/discord.py); gated per-type by DISCORD_ALERT_TYPES.
# DISCORD_WEBHOOK=
# DISCORD_WEBHOOK_URL=
# DISCORD_ALERT_TYPES=structure_attack,structure_fuel

# Optional link to your own Wanderer wormhole-mapper instance. Set it and a
# "Wanderer" item appears in the Map nav group; leave it unset and the item is
# omitted entirely. Point it at YOUR mapper, not someone else's.
# WANDERER_URL=https://mapper.example.com
