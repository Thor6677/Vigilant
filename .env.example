# EVE Online SSO
EVE_CLIENT_ID=your_production_client_id
EVE_CLIENT_SECRET=your_production_client_secret
EVE_CALLBACK_URL=https://yourdomain.com/auth/callback

# App
SECRET_KEY=change_this_to_a_long_random_string
# Must name an ASYNC driver — the app builds an asyncio engine, so a plain
# `sqlite:///` URL fails at startup with "The asyncio extension requires an
# async driver to be used". Docker overrides this to /data/vigilant.db.
DATABASE_URL=sqlite+aiosqlite:///./vigilant.db
DEBUG=false

# EVE character id of the owner/admin. On a fresh deploy with no admin yet,
# ONLY the account that owns this character is auto-promoted to admin at
# startup. Leave unset and no one is auto-promoted (fail closed) — the app
# will log a reminder. Set this to your own character id before first launch.
# ADMIN_CHARACTER_ID=

# Contact address advertised in the outbound HTTP User-Agent, e.g.
# "Vigilant/1.0 (you@example.com)". The third-party APIs this app calls (ESI,
# zKillboard, eve-offline.net/.com, EVE-Scout) all require a real, reachable
# contact so their operators can get hold of whoever is generating the traffic.
# Leave unset and requests go out carrying the project's issue-tracker URL,
# which reaches the maintainers but NOT you — set this to your OWN email so you
# get contacted about your own instance's traffic.
# CONTACT_EMAIL=

# For local dev override these in .env
# EVE_CLIENT_ID=your_dev_client_id
# EVE_CLIENT_SECRET=your_dev_client_secret
# EVE_CALLBACK_URL=http://localhost:8000/auth/callback

# Discord webhooks (both optional, both no-op when unset — and DELIBERATELY
# separate from each other, don't alias them):
# DISCORD_WEBHOOK is the shared ops/backfill-progress ping (see everef_ingest.py).
# DISCORD_WEBHOOK_URL is the user-facing alert relay (structure attacks, fuel
# alerts, etc — see app/notify/discord.py); gated per-type by DISCORD_ALERT_TYPES.
# DISCORD_WEBHOOK=
# DISCORD_WEBHOOK_URL=
# update_available — one message per newly published GitHub Release, with a link
# and the deploy command. Opt-in like every other type: leave it out and the
# admin banner still appears but Discord stays silent.
# DISCORD_ALERT_TYPES=structure_attack,structure_fuel,update_available

# Build version. Set by release CI as a Docker build-arg; leave it unset for a
# source build and the app reports "dev". The update checker treats "dev" as
# "never notify", which is what keeps a dev instance silent.
# VIGILANT_VERSION=dev

# In-app update checker. Polls the GitHub Releases API hourly and tells an admin
# when a newer release exists — a banner in the UI, plus one Discord message per
# release if update_available is in DISCORD_ALERT_TYPES below. It NEVER updates
# itself; you choose when to deploy. Point update_check_repo at your own fork if
# you maintain one.
# UPDATE_CHECK_ENABLED=true
# UPDATE_CHECK_REPO=Thor6677/Vigilant

# Master switch for recurring/ingest background tasks (scheduler, map poller,
# killmail stream, backfills, cache warming). True in production. Set it false
# on a second "dev" instance so it renders pages against seeded data without
# duplicating production's ESI/zKB polling under the same CONTACT_EMAIL.
# BACKGROUND_JOBS_ENABLED=true

# --- Running a dev instance alongside production -----------------------------
# The dev stack (docker-compose.dev.yml) publishes to 127.0.0.1:8001 and is
# reached over an SSH tunnel:
#     ssh -L 8001:127.0.0.1:8001 <your-host>     then http://localhost:8001
#
# It needs its OWN .env with its OWN EVE application. Refresh tokens are bound
# to the client_id that issued them, so production's stored tokens are useless
# in dev — register a second application with the callback below, then log in
# fresh on the dev instance.
#   EVE_CLIENT_ID=your_dev_client_id
#   EVE_CLIENT_SECRET=your_dev_client_secret
#   EVE_CALLBACK_URL=http://localhost:8001/auth/callback
#   BACKGROUND_JOBS_ENABLED=false
# Leave DISCORD_WEBHOOK and DISCORD_WEBHOOK_URL UNSET in dev so it can never
# post to your real alert channel.
#
# Seed its database from production with scripts/refresh-dev-db.sh: it copies
# everything except killmails whole, plus a recent slice of killmails, and
# blanks every stored OAuth token. Production stays up throughout.

# Optional link to your own Wanderer wormhole-mapper instance. Set it and a
# "Wanderer" item appears in the Map nav group; leave it unset and the item is
# omitted entirely. Point it at YOUR mapper, not someone else's.
# WANDERER_URL=https://mapper.example.com
